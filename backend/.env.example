# Database configuration (Supabase PostgreSQL via transaction pooler port 6543)
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Google Gemini API configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_STATE=gemini-3.8-flash
GEMINI_MODEL_RESPONDER=gemini-3.8-flash
GEMINI_MODEL_NOTES=gemini-3.5-flash-lite
# Thinking budget per peran: 0 = mati; kosong/none = default model (wajib untuk model yang menolak 0,
# mis. gemini-3.5-flash-lite). Kombinasi yang ditolak Gemini membuat startup gagal.
GEMINI_THINKING_BUDGET_STATE=0
GEMINI_THINKING_BUDGET_RESPONDER=0
GEMINI_THINKING_BUDGET_NOTES=none
# Validasi model + budget saat startup (matikan untuk tes / tanpa jaringan)
GEMINI_VALIDATE_ON_STARTUP=true

# Simulation settings
NOTES_UPDATE_MODE=background
NOTES_TIMEOUT_S=20
TURN_LOCK_TIMEOUT_S=30
GREETING_SHORTCUT_ENABLED=true
DEBUG_INCLUDE_INTERNAL=false

# CORS settings (JSON list or comma-separated string)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
