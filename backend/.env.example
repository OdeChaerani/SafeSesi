# Salin ke .env, lalu hapus tanda # pada baris yang diisi. Jangan mengaktifkan baris dengan nilai kosong.
# Hanya rahasia dan nilai yang berbeda antar lingkungan; pengaturan lain punya default di core/config.py.

APP_ENV=development

# Wajib diisi: koneksi PostgreSQL.
# DATABASE_URL=

# Wajib diisi di luar development: acak minimal 32 karakter.
# Buat: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=

FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Batas percobaan login/aktivasi/refresh ada di core/rate_limit.py (bukan di sini). Login per IP 200 dan aktivasi
# 100 per 15 menit sengaja longgar: satu IP kampus dipakai bersama 30-40 pengguna.
# Nyalakan hanya jika API tepat di belakang satu reverse proxy tepercaya (lihat core/config.py)
# TRUST_PROXY_HEADERS=false

# Wajib diisi: kunci Gemini.
# GEMINI_API_KEY=
# Wajib diisi bila diaktifkan: nama model per peran. Selama dikomentari, dipakai default core/config.py.
# GEMINI_MODEL_RESPONDER=
# GEMINI_MODEL_NOTES=
# Opsional: angka, atau none (thinking_config tidak dikirim).
# GEMINI_THINKING_BUDGET_RESPONDER=
# GEMINI_THINKING_BUDGET_NOTES=

# Wajib diisi untuk suara klien (TTS) dan transkripsi konselor (STT).
# ELEVEN_LABS_API_KEY=
# GROQ_API_KEY=
