# Konfigurasi Supabase
SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-key
DATABASE_URL=your-database-url

# Google Gemini API configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_RESPONDER=your-gemini-model-responder
GEMINI_MODEL_NOTES=your-gemini-model-notes
GEMINI_THINKING_BUDGET_RESPONDER=your-thinking-budget-responder
GEMINI_THINKING_BUDGET_NOTES=your-thinking-budget-notes

# Eleven Labs API
ELEVEN_LABS_API_KEY=your-eleven-labs-api-key
# ELEVEN_LABS_TTS_MODEL=eleven_flash_v2_5

# Groq Speech-to-Text
GROQ_API_KEY=your-groq-api-key
# GROQ_STT_MODEL=whisper-large-v3-turbo

NODE_ENV=development

# Autentikasi. JWT_SECRET wajib diganti nilai acak minimal 32 karakter jika APP_ENV bukan development
# (aplikasi menolak start dengan nilai bawaan/pendek). Buat: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your-jwt-secret
# APP_ENV=development
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=7
# ACTIVATION_TOKEN_HOURS=72
# Alamat frontend untuk tautan aktivasi akun
FRONTEND_URL=http://localhost:5173
# Origin frontend yang boleh memakai cookie login (spesifik, bukan *)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
