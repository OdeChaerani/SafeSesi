# Salin ke frontend/.env lalu sesuaikan. Variabel harus diawali VITE_ agar terbaca oleh Vite.
# Alamat backend FastAPI (tanpa garis miring di akhir).
# Kosongkan agar permintaan memakai proxy Vite bawaan (/api) di lingkungan development.
# Untuk production dengan domain terpisah, isi URL lengkap backend (mis. https://api.safesesi.ac.id)
VITE_API_BASE_URL=
